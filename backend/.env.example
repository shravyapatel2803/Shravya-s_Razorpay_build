# ── AI Model & Razorpay Keys ──────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# ── JWT Authentication ────────────────────────────────────────────────────
SECRET_KEY=generate_with_python_secrets_token_hex_32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Environment & Security ────────────────────────────────────────────────
ENVIRONMENT=production
VERIFY_WEBHOOK_SIGNATURE=false
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# ── URLs & Port (Set automatically by Render) ─────────────────────────────
PORT=10000
FRONTEND_URL=https://your-frontend.vercel.app

# ── Default Admin Seed Credentials ─────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@razorpay-recovery.local
DEFAULT_ADMIN_PASSWORD=AdminPass@2026!

# ── Database (Optional: Render Managed PostgreSQL) ─────────────────────────
# DATABASE_URL=postgresql://user:password@host/database
